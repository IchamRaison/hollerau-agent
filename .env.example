# Copy to .env (never commit it). Real environment variables win over this file.
ARENA_URL=https://arena.tacto.ai
# Team key from https://arena.tacto.ai/apply (one per team)
ARENA_API_KEY=
# `uv run arena data` unpacks the package here (+ release-sunday once public)
ARENA_DATA=data/package

# LLM for the buyer agent (our own key). Anthropic ...
LLM_PROVIDER=anthropic
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
ANTHROPIC_API_KEY=
# ... or any OpenAI-compatible endpoint
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=
# LLM_API_KEY=

# Model comparison (lab/model_bench.py), keys only - never commit values
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# pegasus, the agent we play (uv run pegasus ...). Defaults shown; everything set here is recorded in
# data/runs/<run>/config.json before a run starts.
# PEGASUS_POLICY=schedule        # or "actions": moves compared on what they give and get (not measured yet)
# PEGASUS_READER=0               # 1: LLM reader of the supplier's replies (needs LLM_BASE_URL, LLM_MODEL, LLM_API_KEY)
# PEGASUS_STRATEGIST=0           # 1: an LLM picks one of the moves the code listed (actions policy only)
# PEGASUS_DECISION_BUDGET_S=40   # our side of a round: reading, deciding, checking
